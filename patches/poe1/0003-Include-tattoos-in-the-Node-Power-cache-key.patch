From ec82794a558d8aca836ad4695753855a8833d79c Mon Sep 17 00:00:00 2001
From: Judd <ipajudd@gmail.com>
Date: Sun, 4 Oct 2026 15:11:50 -0700
Subject: [PATCH] Include tattoos in the Node Power cache key

A tattooed passive and an ordinary passive with the same stats shared a
cache entry, but Warrior's Tale only boosts tattoos in its radius and tattoo
counts depend on the tattoo type. With Tattoo of the Ngamahu Makanga on a
node in a Warrior's Tale radius, an ordinary node with the same stats showed
the tattooed node's gain.

The key now also includes the tattoo type.
---
 src/Classes/CalcsTab.lua | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/Classes/CalcsTab.lua b/src/Classes/CalcsTab.lua
index c253ceb13..69613eadc 100644
--- a/src/Classes/CalcsTab.lua
+++ b/src/Classes/CalcsTab.lua
@@ -492,9 +492,10 @@ function CalcsTabClass:BuildPower()
 	end
 end
 
--- Nodes with the same modKey can still calculate differently, as radius jewels only apply to the nodes in their radius
+-- Nodes with the same modKey can still calculate differently: radius jewels only apply to the nodes in their radius,
+-- and tattoos are counted by type and boosted by jewels such as Warrior's Tale
 local function powerCacheKey(env, node)
-	local key = node.modKey .. "|" .. node.type
+	local key = node.modKey .. "|" .. node.type .. (node.isTattoo and "|" .. tostring(node.overrideType) or "")
 	for index, rad in ipairs(env.radiusJewelList) do
 		if rad.nodes[node.id] then
 			key = key .. "|" .. index
-- 
